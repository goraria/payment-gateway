# Local examples below. On Vercel use NODE_ENV=production, stable HTTPS origins,
# service-owned PostgreSQL and production provider settings. Never upload .env.local.
# Bun 1.4.4 builds the project; Functions run on Node.js 24.
NODE_ENV=development
NITRO_PUBLIC_PORT=5055
NITRO_PUBLIC_SERVICE_URL=http://localhost:5055
NITRO_PUBLIC_AUTH_URL=https://gorth-auth.vercel.app
DATABASE_URL=
PG_POOL_MAX=10
# Existing confidential Payment client; grant commerce:payment:sync for Commerce.
NITRO_OAUTH_CLIENT_ID=
NITRO_OAUTH_CLIENT_SECRET=

# Stripe. Never expose the secret key or webhook secret to a browser bundle.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# MoMo Payment Gateway (sandbox defaults shown).
MOMO_ENABLED=false
MOMO_API_URL=https://test-payment.momo.vn
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_PARTNER_NAME=GORTH
MOMO_STORE_ID=Gorth
MOMO_REDIRECT_URL=http://localhost:5055/payment/return/momo
MOMO_IPN_URL=http://localhost:5055/payment/webhook/momo
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api
MOMO_SIGNATURE_KEY=
MOMO_PAYMENT_CODE=

# ZaloPay sandbox.
ZALOPAY_API_URL=https://sb-openapi.zalopay.vn

ZALOPAY_MERCHANT_ENABLED=true
ZALOPAY_MERCHANT_APP_ID=
ZALOPAY_MERCHANT_KEY1=
ZALOPAY_MERCHANT_KEY2=
ZALOPAY_MERCHANT_ENDPOINT=https://sb-openapi.zalopay.vn/v2/create
ZALOPAY_MERCHANT_GATEWAY_ENDPOINT=https://sb-openapi.zalopay.vn/v2/query
ZALOPAY_MERCHANT_CALLBACK_URL=http://localhost:5055/payment/webhook/zalopay
ZALOPAY_MERCHANT_REDIRECT_URL=http://localhost:5055/payment/return/zalopay

# VNPay sandbox.
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5055/payment/return/vnpay
# Configure this URL as the IPN URL in the VNPay merchant portal.
VNPAY_IPN_URL=http://localhost:5055/payment/webhook/vnpay
VNPAY_LOCALE=vn
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# PayPal.
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_ENVIRONMENT=sandbox

# Vercel scheduled task authentication; use an independent random value.
CRON_SECRET=
# Set automatically by Vercel. Leave blank locally.
VERCEL=
# Keep external OTLP exporters unset; telemetry policy disables export if configured.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_TRACES_HEADERS=

# Queue authentication uses Vercel-provided OIDC; enable Queues in the owning project.
# Cron requires CRON_SECRET and a plan supporting the schedules in nitro.config.ts.

# NITRO_OAUTH_CLIENT_BINDINGS is reserved. OAuth client bindings come from SSO.
# NITRO_OAUTH_CLIENT_BINDINGS=

# Peer origins/audiences are resolved
# from /.well-known/gorth-application using the local or production OAuth registry.
# Configure client homepages and resource identifiers in SSO; do not add peer URLs here.
